<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Anthill.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- The Colony Director lives in the API host project; testing it needs the ASP.NET shared framework. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Anthill.Api\Anthill.Api.csproj" />
    <!-- The provider implementations moved out of the core in v3.8.5; their tests follow them. -->
    <ProjectReference Include="..\..\src\Anthill.Modules\Anthill.Modules.Reasoning\Anthill.Modules.Reasoning.csproj" />
    <ProjectReference Include="..\..\src\Anthill.Modules\Anthill.Modules.Homelab\Anthill.Modules.Homelab.csproj" />
    <!-- The tool implementations moved out of the core in v3.8.16; their tests follow them. -->
    <ProjectReference Include="..\..\src\Anthill.Modules\Anthill.Modules.Tools\Anthill.Modules.Tools.csproj" />
    <ProjectReference Include="..\..\src\Anthill.Modules\Anthill.Modules.Knowledge\Anthill.Modules.Knowledge.csproj" />
    <!--
      Scenario 17 needs a process it can really kill. Referenced (rather than located by path) so
      `dotnet test` builds it and copies it beside the tests — a helper the suite cannot find is a
      scenario that silently does not run, which is the state scenario 17 was already in.
      The output IS copied (no ReferenceOutputAssembly="false"): with it suppressed the helper is
      built and left in its own bin, and the test would have to guess a configuration-dependent path
      to find it. Copied, it sits beside the tests with the runtimeconfig.json that
      EnableDynamicLoading emits, and `dotnet exec` on it just works.
    -->
    <ProjectReference Include="..\..\tests\Anthill.CrashHelper\Anthill.CrashHelper.csproj" />
    <!--
      Referenced so ModuleBoundaryTests can Assembly.Load it. Without this the module is simply
      absent from the test output directory and its boundary theory case cannot run — which is
      indistinguishable from passing.
    -->
  </ItemGroup>

  <!-- MICROMOUND is optional: the boundary check on its assembly only exists when the wire
       contract does. Same condition and define as Anthill.Api. -->
  <PropertyGroup>
    <MicromoundRepoPath Condition="'$(MicromoundRepoPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\micromound</MicromoundRepoPath>
    <MicromoundPresent Condition="Exists('$(MicromoundRepoPath)\src\Micromound.Protocol\Micromound.Protocol.csproj')">true</MicromoundPresent>
    <DefineConstants Condition="'$(MicromoundPresent)' == 'true'">$(DefineConstants);MICROMOUND</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(MicromoundPresent)' == 'true'">
    <ProjectReference Include="..\..\src\Anthill.Modules\Anthill.Modules.Micromound\Anthill.Modules.Micromound.csproj" />
  </ItemGroup>

</Project>
