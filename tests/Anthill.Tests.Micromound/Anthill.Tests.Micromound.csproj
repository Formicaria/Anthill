<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Anthill.Tests.Micromound</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <MicromoundRepoPath Condition="'$(MicromoundRepoPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\micromound</MicromoundRepoPath>
    <MicromoundRepoFullPath>$([System.IO.Path]::GetFullPath('$(MicromoundRepoPath)'))</MicromoundRepoFullPath>
  </PropertyGroup>

  <!--
    THE CHECKOUT THIS ASSEMBLY WAS COMPILED AGAINST, baked in at build time.

    `DeviceWireContractTests` reads the device's HTTP clients out of the pinned micromound
    checkout — the one contract that cannot be checked from a type or a runtime on this side,
    because the field names live in private records inside an executable. Finding that checkout
    from `typeof(SimMound).Assembly.Location` does NOT work: the reference is COPIED into this
    project's output directory, so the walk lands inside the ANTHILL repo and finds nothing. And a
    hardcoded sibling path stops pointing at the thing under test the moment anybody overrides
    `MicromoundRepoPath` — which CI does.

    So MSBuild records the path it actually resolved, and the guard reads that.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>MicromoundRepoPath</_Parameter1>
      <_Parameter2>$(MicromoundRepoFullPath)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Anthill.Modules\Anthill.Modules.Micromound\Anthill.Modules.Micromound.csproj" />
    <!--
      The device simulator, referenced on purpose. The colony's sync path could be tested against
      hand-built envelopes, but hand-built envelopes are written by whoever wrote the code being
      tested and agree with it by construction. Driving SimMound means the bytes, the signatures
      and the hash chain all come from the device implementation — so a divergence between the two
      sides shows up here rather than on a Pi in a shed.
    -->
    <ProjectReference Include="$(MicromoundRepoPath)\src\Micromound.Sim\Micromound.Sim.csproj" />
  </ItemGroup>

</Project>
