<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Anthill.Api</RootNamespace>
    <AssemblyName>Anthill.Api</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Anthill.Core\Anthill.Core.csproj" />
    <!-- Explicit, though it would arrive transitively through Core: the API names SDK types
         directly (the SSE endpoint consumes IEventBus), and a reference you depend on by name
         should not rely on another project continuing to bring it along. -->
    <ProjectReference Include="..\Anthill.SDK\Anthill.SDK.csproj" />
    <!-- Composition root: modules are wired in here, never referenced by the core. -->
    <ProjectReference Include="..\Anthill.Modules\Anthill.Modules.Reasoning\Anthill.Modules.Reasoning.csproj" />
    <ProjectReference Include="..\Anthill.Modules\Anthill.Modules.Homelab\Anthill.Modules.Homelab.csproj" />
    <ProjectReference Include="..\Anthill.Modules\Anthill.Modules.Tools\Anthill.Modules.Tools.csproj" />
  </ItemGroup>

  <!-- Let the test suite exercise internal helpers (e.g. the mission-report formatter). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Anthill.Tests" />
  </ItemGroup>

  <!-- The colony UI is embedded so the API stays self-contained. v2.6.3: the page script lives in
       app.js (served 'self') so the console carries no inline JS — required to drop CSP
       script-src 'unsafe-inline'. -->
  <ItemGroup>
    <!--
      v3.8.17 (phase 6) — the assets live in src/Anthill.UI/ and the API serves them. Still
      EMBEDDED rather than copied to disk, because a self-contained binary is the deployment model
      and phase 6's gate is that the API boots and serves when the assets are ABSENT, not that they
      are loose files.

      LogicalName is pinned deliberately. Without it the resource name is derived from the file's
      path relative to the project, and these now sit outside it — so the generated names would
      change. `LoadUiAsset` finds assets by name SUFFIX, so a changed prefix would still have
      worked and a changed suffix would have served a blank console with no build error. Naming
      them explicitly means the move cannot alter what is served.
    -->
    <!--
      v3.8.18 — conditioned on AnthillNoUi so the "core runs without UI" criterion can be BUILT
      rather than simulated. `dotnet build -p:AnthillNoUi=true` produces an API with no console
      assets embedded at all; CI then boots it and hits /health. The previous gate asked
      LoadUiAsset for a fabricated resource name and watched it return the fallback, which proves a
      null check and nothing about a build. An external review called that wrong-green and was right.
    -->
    <EmbeddedResource Include="..\Anthill.UI\index.html" LogicalName="Anthill.Api.Ui.index.html" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\app.js" LogicalName="Anthill.Api.Ui.app.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\mission-thread.js" LogicalName="Anthill.Api.Ui.mission-thread.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <!-- v0.3.8.52: the app.js split. Each domain file needs its own pin — the single-file
         self-contained binary serves these from embedded resources, so an unpinned asset 404s at
         runtime while building and testing perfectly. -->
    <EmbeddedResource Include="..\Anthill.UI\homelab.js" LogicalName="Anthill.Api.Ui.homelab.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\inspector-routing.js" LogicalName="Anthill.Api.Ui.inspector-routing.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\themes.js" LogicalName="Anthill.Api.Ui.themes.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\console-extras.js" LogicalName="Anthill.Api.Ui.console-extras.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <!-- v3.3.0: the responsive dashboard grid that replaces the floating-panel workspace. -->
    <EmbeddedResource Include="..\Anthill.UI\dashboard-grid.js" LogicalName="Anthill.Api.Ui.dashboard-grid.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\dashboard-grid.css" LogicalName="Anthill.Api.Ui.dashboard-grid.css" Condition="'$(AnthillNoUi)' != 'true'" />
    <!-- Colony Live (design doc §17, stage 3) — the opt-in 3D formicarium view (topology projection + renderer). -->
    <EmbeddedResource Include="..\Anthill.UI\colony-topology.js" LogicalName="Anthill.Api.Ui.colony-topology.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\colony-live.js" LogicalName="Anthill.Api.Ui.colony-live.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\colony-renderer.js" LogicalName="Anthill.Api.Ui.colony-renderer.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\colony-host.js" LogicalName="Anthill.Api.Ui.colony-host.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\colony-hud.js" LogicalName="Anthill.Api.Ui.colony-hud.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <!--
      v0.3.8.115 — THE ONE VENDORED RUNTIME DEPENDENCY THE CONSOLE HAS, and the rules it lives by.

      three.js 0.128.0, `build/three.min.js`, MIT, pinned by EXACT version and served from this
      origin like every other asset. It is embedded here for the same reason `app.js` is: the
      single-file self-contained binary has no wwwroot, so an unpinned asset 404s at runtime while
      building and testing perfectly.

      WHY THE UMD BUILD AND NOT A MODULE. The console is non-module vanilla JavaScript loaded with
      plain `<script src>` tags. The UMD build defines `window.THREE` under exactly that, so the CSP
      stays `script-src 'self'` with no `unsafe-eval`, no import map, and no bundler. Later three
      releases dropped the UMD minified build; that is why the pin is 0.128.0 and why moving it is a
      decision rather than a bump.

      NO CDN, NO BLOB, NO RUNTIME DOWNLOAD. The reference prototype fetched this from unpkg and
      evaluated it from a Blob URL when the vendored copy was missing. That path is not ported: it
      needs `script-src blob:` and a network the colony may not have, and a console that silently
      reaches the internet to render is not one an air-gapped operator can trust.
    -->
    <EmbeddedResource Include="..\Anthill.UI\vendor\three.min.js" LogicalName="Anthill.Api.Ui.vendor.three.min.js" Condition="'$(AnthillNoUi)' != 'true'" />
    <EmbeddedResource Include="..\Anthill.UI\vendor\three.LICENSE" LogicalName="Anthill.Api.Ui.vendor.three.LICENSE" Condition="'$(AnthillNoUi)' != 'true'" />
  </ItemGroup>

  <!--
    MICROMOUND is an OPTIONAL integration. The module compiles against the wire contract in the
    sibling micromound repository; a colony without that checkout is a complete colony — it builds,
    boots and tests with no micromound anywhere in it. When the checkout exists (or
    MicromoundRepoPath points at one), the module is composed in and the MICROMOUND define lights
    up the wiring in ApiHost. CI checks the contract out explicitly, so the integration is always
    exercised there; a dev box only pays for what it has.
  -->
  <PropertyGroup>
    <MicromoundRepoPath Condition="'$(MicromoundRepoPath)' == ''">$(MSBuildThisFileDirectory)..\..\..\micromound</MicromoundRepoPath>
    <MicromoundPresent Condition="Exists('$(MicromoundRepoPath)\src\Micromound.Protocol\Micromound.Protocol.csproj')">true</MicromoundPresent>
    <DefineConstants Condition="'$(MicromoundPresent)' == 'true'">$(DefineConstants);MICROMOUND</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(MicromoundPresent)' == 'true'">
    <ProjectReference Include="..\Anthill.Modules\Anthill.Modules.Micromound\Anthill.Modules.Micromound.csproj" />
  </ItemGroup>

</Project>
