<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Anthill.SDK</RootNamespace>
    <AssemblyName>Anthill.SDK</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    CONTRACTS ONLY. This project is the pivot of the module boundary: Core and every module
    reference it, and it references nothing that could drag an implementation along with it.

    The package list is deliberately near-empty and should stay that way. The moment the SDK
    takes a dependency on a database driver, an HTTP client, or a provider SDK, every module in
    the colony inherits it and the boundary this project exists to draw stops meaning anything.
    Logging.Abstractions is admitted because it is abstractions by construction.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      v3.8.18 — SafetyPolicy.Configure/Reset became internal, so the assemblies allowed to install
      or reset process-wide safety policy are named here rather than being "anyone who references
      the SDK". Anthill.Core installs the live readers from its module initializer; the test
      projects need Reset to prove the unconfigured path. Nothing else may.
    -->
    <InternalsVisibleTo Include="Anthill.Core" />
    <InternalsVisibleTo Include="Anthill.Tests" />
    <InternalsVisibleTo Include="Anthill.Tests.Homelab" />
  </ItemGroup>

</Project>
