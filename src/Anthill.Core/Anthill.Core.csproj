<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Anthill.Core</RootNamespace>
    <AssemblyName>Anthill.Core</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Let the test suites exercise internal helpers (e.g. AutoApplyPolicy.GlobMatches). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Anthill.Tests" />
    <InternalsVisibleTo Include="Anthill.Tests.Infrastructure" />
  </ItemGroup>

  <!--
    The contracts project. Core implements SDK interfaces; it must never reference a module.
    Added in Phase 0 while still unused, so the reference is proven to compile before Phase 1
    depends on it.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Anthill.SDK\Anthill.SDK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADO.NET SQLite provider — the managed replacement for Python's sqlite3 module. -->
    <!-- v0.3.9.4 — 10.0.0 to match the TFM, and because 9.0.0 drags SQLitePCLRaw.lib.e_sqlite3
         2.1.10 in transitively, which carries GHSA-2m69-gcr7-jv3q (high). The net10 SDK audits
         transitive packages by default where net9 audited direct ones only, so the TFM move did
         not create this — it started looking where nobody had looked. See W0-05-CENSUS.md. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Explicit, to override the vulnerable 2.1.11 this would otherwise resolve. Version lives in
         Directory.Build.props so there is one to change rather than three. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="$(SqlitePclRawVersion)" />
    <!-- In-memory cache for the speed layer over memory reads. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <!--
    The native kernel is copied next to the managed output so DllImport can find it.
    Build the kernel first (see native/anthill_kernel/CMakeLists.txt); the wildcard
    below picks up whichever platform artifact CMake produced.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\..\native\anthill_kernel\**\*anthill_kernel*.dll;$(MSBuildThisFileDirectory)..\..\native\anthill_kernel\**\*anthill_kernel*.so;$(MSBuildThisFileDirectory)..\..\native\anthill_kernel\**\*anthill_kernel*.dylib"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\native\anthill_kernel')"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
