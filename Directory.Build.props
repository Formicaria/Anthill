<Project>
  <!--
    Shared build settings for every ANTHILL .NET project.
    Centralising these here keeps the individual .csproj files small and means a
    single edit flips the target framework or language version for the whole solution.
  -->
  <PropertyGroup>
    <!--
      v0.3.9 / W0 05 — net10.0. .NET 9 is STS and leaves support on 10 November 2026; .NET 10 is LTS
      to 14 November 2028. MICROMOUND made this move at v0.9.36 and ANTHILL could not consume it
      afterwards: a net9.0 project cannot reference a net10.0 one, and no SDK version fixes that
      direction. See docs/transition/adr/ADR-001-dotnet-target-framework.md.

      LangVersion deliberately stays at 13, the same rule MICROMOUND used: this is a RUNTIME move and
      a runtime move must not change a signed byte. C# 14 is a separate decision on its own merits.

      NOTE the interaction with TreatWarningsAsErrors below. A TFM bump admits the net10 analyzer set
      against that flag, so new warnings arrive as build FAILURES. Re-run the census the way .112 did.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      v0.3.8.112 — WARNINGS ARE ERRORS. R0's last item, and it was `false` explicitly rather than by
      omission, which reads as a decision somebody took and is worth replacing with a measured one.

      MEASURED, NOT ASSUMED. A census across the whole solution at `.111` returned ZERO warnings, so
      this flips a clean tree rather than declaring bankruptcy on a dirty one. That order matters:
      turning it on over a backlog forces either a suppression file or a wave of unrelated edits in
      the same commit, and both of those teach that the setting is negotiable.

      WHAT IS NOT RAISED, and it is named rather than left as an apparent oversight. `AnalysisMode`
      stays at the SDK default. Raising it to `Recommended` or `All` admits the whole CA ruleset at
      once, and with this flag on, every one of those becomes a build failure — a change whose blast
      radius cannot be known without measuring it, exactly as this one was. §2c carries it.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <!--
      SQLITEPCLRAW, PINNED HERE AND NOWHERE ELSE. v0.3.9.4.

      Microsoft.Data.Sqlite 10.0.0 resolves bundle_e_sqlite3 2.1.11, and 2.1.11 carries
      GHSA-2m69-gcr7-jv3q (high) exactly like the 2.1.10 before it. The net10 SDK audits
      TRANSITIVE packages by default where net9 audited direct ones only, so nothing here got
      worse — the SDK just started looking somewhere nobody had looked, and found something that
      had been sitting there the whole time. `dotnet nuget why` showed the same three-link chain
      under all eight projects, so one override at the bundle closes all of them.

      NOT 3.53.3. The 3.x line renumbered to track SQLite's own version, and raw's core, provider,
      lib and bundle have to stay aligned with each other — pinning the bundle forward while
      Microsoft.Data.Sqlite still expects the 2.1.x contract buys a runtime DllNotFoundException
      instead of a build error, which is a worse trade in every direction.
    -->
    <SqlitePclRawVersion>2.1.13</SqlitePclRawVersion>
    <!-- v0.3.8.48, found by Windows CI: invariant globalization disables the ICU mapping that
         lets Windows resolve IANA timezone ids ("America/Chicago"), so FindSystemTimeZoneById
         threw, the scheduler's fallback degraded every zone to UTC, and each Windows schedule
         would have fired hours off its local time. Linux never showed it — tz lookups there
         come from the OS zoneinfo files, no ICU required. Globalization stays ON so the
         project-schedule contract (UTC instants beside real IANA zones) holds on every OS. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Must always match AnthillRuntime.Version — enforced by RegressionGuardTests + CI. -->
    <AnthillVersion>0.3.9.10</AnthillVersion>
    <Version>$(AnthillVersion)</Version>
    <Authors>ANTHILL Project</Authors>
    <Product>ANTHILL Core</Product>
  </PropertyGroup>
</Project>
