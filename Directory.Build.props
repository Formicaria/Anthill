<Project>
  <!--
    Shared build settings for every ANTHILL .NET project.
    Centralising these here keeps the individual .csproj files small and means a
    single edit flips the target framework or language version for the whole solution.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      v0.3.8.112 — WARNINGS ARE ERRORS. R0's last item, and it was `false` explicitly rather than by
      omission, which reads as a decision somebody took and is worth replacing with a measured one.

      MEASURED, NOT ASSUMED. A census across the whole solution at `.111` returned ZERO warnings, so
      this flips a clean tree rather than declaring bankruptcy on a dirty one. That order matters:
      turning it on over a backlog forces either a suppression file or a wave of unrelated edits in
      the same commit, and both of those teach that the setting is negotiable.

      WHAT IS NOT RAISED, and it is named rather than left as an apparent oversight. `AnalysisMode`
      stays at the SDK default. Raising it to `Recommended` or `All` admits the whole CA ruleset at
      once, and with this flag on, every one of those becomes a build failure — a change whose blast
      radius cannot be known without measuring it, exactly as this one was. §2c carries it.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- v0.3.8.48, found by Windows CI: invariant globalization disables the ICU mapping that
         lets Windows resolve IANA timezone ids ("America/Chicago"), so FindSystemTimeZoneById
         threw, the scheduler's fallback degraded every zone to UTC, and each Windows schedule
         would have fired hours off its local time. Linux never showed it — tz lookups there
         come from the OS zoneinfo files, no ICU required. Globalization stays ON so the
         project-schedule contract (UTC instants beside real IANA zones) holds on every OS. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Must always match AnthillRuntime.Version — enforced by RegressionGuardTests + CI. -->
    <AnthillVersion>0.3.8.116</AnthillVersion>
    <Version>$(AnthillVersion)</Version>
    <Authors>ANTHILL Project</Authors>
    <Product>ANTHILL Core</Product>
  </PropertyGroup>
</Project>
